# EmailSignal sidecar — copy to server/.env and fill in.
# The Chrome extension never reads this file; it talks to the server over HTTP.

OPENAI_API_KEY=sk-...

# Optional Weave observability
WANDB_API_KEY=
WANDB_PROJECT=email-signal

# Optional Redis (otherwise memory falls back to in-process map)
REDIS_URL=

# Bind port (defaults to 3030)
EMAIL_SIGNAL_PORT=3030

# Model. Any chat model the OpenAI Agents SDK supports.
EMAIL_SIGNAL_MODEL=gpt-4.1-mini
