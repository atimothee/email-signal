# EmailSignal sidecar — copy to server/.env and fill in.
# The Chrome extension never reads this file; it talks to the server over HTTP.
#
# OPENAI_API_KEY, EMAIL_SIGNAL_MODEL, WANDB_API_KEY, and WANDB_PROJECT can also be
# set in the extension Settings, which TAKE PRECEDENCE (forwarded per request).
# The values here are the fallback used when the matching Settings field is blank.

OPENAI_API_KEY=sk-...

# Optional Weave observability
WANDB_API_KEY=
WANDB_PROJECT=email-signal

# Optional Redis (otherwise memory falls back to in-process map).
# For semantic features (Context Retriever vector index + semantic recall) this
# MUST point at Redis Stack or Redis 8+ (which bundle the search module). A plain
# Redis without the module degrades to a silent no-op — the pipeline still runs.
# `docker compose up` (see docker-compose.yml) brings up Redis Stack for you.
REDIS_URL=

# Optional Agent Memory Server (Redis Iris Agent Memory OSS stand-in): two-tier
# working + long-term memory with semantic recall, dedup, topic/entity extraction.
# Unset → every memory call no-ops and the hand-rolled MemoryStore stays the
# source of truth (byte-identical to pre-Iris behavior). docker-compose.yml
# stands it up at http://localhost:8000.
AGENT_MEMORY_URL=

# Context Retriever: how many prior decisions to inject into synthesis (0 = off).
EMAIL_SIGNAL_CONTEXT_K=5

# Bind port (defaults to 3030)
EMAIL_SIGNAL_PORT=3030

# Model. Any chat model the OpenAI Agents SDK supports.
EMAIL_SIGNAL_MODEL=gpt-4.1-mini
