# EmailSignal — local environment configuration
# NEVER commit your real .env. The extension build will inline values at build time only
# for keys prefixed with VITE_. The agent backend reads the rest from process.env.

# ---- LLM ----
OPENAI_API_KEY=sk-...

# ---- W&B Weave observability ----
WANDB_API_KEY=
WANDB_PROJECT=email-signal

# ---- Memory ----
# If REDIS_URL is unset, EmailSignal falls back to a local JSON store under .data/memory.json
REDIS_URL=

# ---- Runtime ----
# DRY_RUN=true means no actual click/archive/mark-read calls will execute — they will be
# proposed and recorded as if they ran, for safe local development.
EMAIL_SIGNAL_DRY_RUN=true

# Set to false to allow the extension to send full email bodies to the LLM.
# Default keeps bodies truncated to ~512 chars before any model call.
EMAIL_SIGNAL_SEND_FULL_BODIES=false

# Chrome notifications cadence (minutes). 0 disables.
EMAIL_SIGNAL_NOTIFY_INTERVAL_MIN=30
